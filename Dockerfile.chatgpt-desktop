FROM linuxserver/webtop:ubuntu-xfce-5a2151ed-ls5

ARG TARGETARCH
ARG CHATGPT_CACHE_BUST=0

RUN apt update && \
    apt install -y --no-install-recommends ca-certificates curl && \
    curl --fail --show-error --silent --location --retry 3 \
      "https://persistent.oaistatic.com/codex-app-prod/linux/deb/latest/chatgpt_${TARGETARCH}.deb" \
      --output /tmp/chatgpt.deb && \
    apt install -y --no-install-recommends /tmp/chatgpt.deb && \
    command -v chatgpt && \
    rm -f /tmp/chatgpt.deb && \
    apt clean && \
    rm -rf /var/lib/apt/lists/*

RUN mkdir -p -m 755 /etc/apt/keyrings && \
    curl --fail --show-error --silent --location --retry 3 \
      https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      --output /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
	chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg && \
	mkdir -p -m 755 /etc/apt/sources.list.d && \
	echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null && \
	apt update && \
	apt install gh -y && \
    apt clean && \
    rm -rf /var/lib/apt/lists/*
